<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <!-- The launcher over the stock login screen: saved servers on the left, the accounts saved on
         the selected one on the right, one tap to sign in. Servers and accounts are the host's
         (crates/benilla-app/src/mobile/launcher.rs), through the BenillaLauncher_* functions; a
         sign-in sets the realmlist and the realm override, fills the stock boxes and runs
         AccountLogin_Login, so the stock connecting dialog and errors show. "Sign In Manually"
         hides the launcher and shows the stock boxes; an account typed there is saved once it
         reaches character select. Sized for a finger. -->
    <Script><![CDATA[
        BENILLA_LAUNCHER_ROWS = 5

        BenillaLauncher = { server = 1, serverTop = 0, accountTop = 0 }

        function BenillaLauncher_Refresh()
            local n = BenillaLauncher_NumProfiles()
            if BenillaLauncher.server > n then BenillaLauncher.server = n end
            if BenillaLauncher.server < 1 then BenillaLauncher.server = 1 end
            for k = 1, BENILLA_LAUNCHER_ROWS do
                local i = k + BenillaLauncher.serverTop
                local row = getglobal("BenillaLauncherServer" .. k)
                local name, address = BenillaLauncher_GetProfile(i)
                if name then
                    row.index = i
                    getglobal(row:GetName() .. "Name"):SetText(name)
                    getglobal(row:GetName() .. "Address"):SetText(address)
                    if i == BenillaLauncher.server then row:LockHighlight() else row:UnlockHighlight() end
                    row:Show()
                else
                    row:Hide()
                end
            end
            local _, _, _, accounts = BenillaLauncher_GetProfile(BenillaLauncher.server)
            accounts = accounts or 0
            for k = 1, BENILLA_LAUNCHER_ROWS do
                local j = k + BenillaLauncher.accountTop
                local row = getglobal("BenillaLauncherAccount" .. k)
                local name, saved = BenillaLauncher_GetAccount(BenillaLauncher.server, j)
                if name then
                    row.index = j
                    getglobal(row:GetName() .. "Name"):SetText(name)
                    if saved then
                        getglobal(row:GetName() .. "State"):SetText("Tap to sign in")
                    else
                        getglobal(row:GetName() .. "State"):SetText("Tap to enter the password")
                    end
                    row:Show()
                else
                    row:Hide()
                end
            end
            if n == 0 then
                BenillaLauncherEmpty:Show()
                BenillaLauncherEditServer:Disable()
                BenillaLauncherRemoveServer:Disable()
                BenillaLauncherAddAccount:Disable()
            else
                BenillaLauncherEmpty:Hide()
                BenillaLauncherEditServer:Enable()
                BenillaLauncherRemoveServer:Enable()
                BenillaLauncherAddAccount:Enable()
            end
            if accounts == 0 and n > 0 then BenillaLauncherNoAccounts:Show() else BenillaLauncherNoAccounts:Hide() end
            BenillaLauncherAuto:SetChecked(BenillaLauncher_AutoLoginEnabled())
        end

        -- The stock boxes hide under the launcher, so their focus raises no keyboard.
        function BenillaLauncher_ShowStock(show)
            local stock = { AccountLoginAccountEdit, AccountLoginPasswordEdit, AccountLoginLoginButton,
                AccountLoginSaveAccountName, AccountLoginSaveAccountNameText }
            for _, f in ipairs(stock) do
                if f then
                    if show then f:Show() else f:Hide() end
                end
            end
            if show then
                BenillaLauncherFrame:Hide()
                BenillaLauncherBack:Show()
                AccountLoginAccountEdit:SetFocus()
            else
                AccountLoginAccountEdit:ClearFocus()
                AccountLoginPasswordEdit:ClearFocus()
                BenillaLauncherBack:Hide()
                BenillaLauncherFrame:Show()
            end
        end

        function BenillaLauncher_SignIn(i, j)
            local user, pass, address, over = BenillaLauncher_Credentials(i, j)
            if not user then return end
            if not pass then
                BenillaLauncherEditor_Open("account", i, j)
                return
            end
            -- The glue has no SetCVar; "-" is no override, as ConsoleExec writes no empty value.
            ConsoleExec("realmList " .. address)
            if over and over ~= "" then
                ConsoleExec("mobileRealmOverride " .. over)
            else
                ConsoleExec("mobileRealmOverride -")
            end
            AccountLoginAccountEdit:SetText(user)
            AccountLoginPasswordEdit:SetText(pass)
            -- The realmlist write lands at the next CVar flush; the login reads it then.
            BenillaLauncher.pendingLogin = 2
        end

        function BenillaLauncherFrame_OnUpdate()
            if BenillaLauncher.pendingLogin then
                BenillaLauncher.pendingLogin = BenillaLauncher.pendingLogin - 1
                if BenillaLauncher.pendingLogin <= 0 then
                    BenillaLauncher.pendingLogin = nil
                    AccountLogin_Login()
                end
            end
        end

        function BenillaLauncherFrame_OnShow()
            BenillaLauncher_ShowStock(nil)
            local i, j = BenillaLauncher_GetLast()
            if i then BenillaLauncher.server = i end
            BenillaLauncher_Refresh()
            local ai, aj = BenillaLauncher_TakeAutoLogin()
            if ai then
                BenillaLauncher.server = ai
                BenillaLauncher_Refresh()
                BenillaLauncher_SignIn(ai, aj)
            end
        end

        -- ── The editor: a server (name, address, realm override) or an account (name, password) ──
        function BenillaLauncherEditor_Open(kind, i, j)
            local e = BenillaLauncherEditor
            e.kind, e.server, e.account = kind, i, j
            BenillaLauncherEditorError:SetText("")
            if kind == "server" then
                local name, address, over = BenillaLauncher_GetProfile(i)
                BenillaLauncherEditorTitle:SetText(i and "Edit Server" or "Add Server")
                BenillaLauncherEditorLabel1:SetText("Name")
                BenillaLauncherEditorLabel2:SetText("Server Address (realmlist)")
                BenillaLauncherEditorLabel3:SetText("Realm Address Override (for servers behind NAT)")
                BenillaLauncherEditorField1:SetText(name or "")
                BenillaLauncherEditorField2:SetText(address or "")
                BenillaLauncherEditorField3:SetText(over or "")
                BenillaLauncherEditorField2:SetPassword(nil)
                BenillaLauncherEditorField3:Show()
                BenillaLauncherEditorLabel3:Show()
                BenillaLauncherEditorSaveAndSignIn:Hide()
            else
                local name = BenillaLauncher_GetAccount(i, j)
                BenillaLauncherEditorTitle:SetText(j and "Enter Password" or "Add Account")
                BenillaLauncherEditorLabel1:SetText("Account Name")
                BenillaLauncherEditorLabel2:SetText("Password")
                BenillaLauncherEditorField1:SetText(name or "")
                BenillaLauncherEditorField2:SetText("")
                BenillaLauncherEditorField2:SetPassword(1)
                BenillaLauncherEditorField3:Hide()
                BenillaLauncherEditorLabel3:Hide()
                BenillaLauncherEditorSaveAndSignIn:Show()
            end
            BenillaLauncherFrame:Hide()
            e:Show()
            if kind == "account" and j then
                BenillaLauncherEditorField2:SetFocus()
            else
                BenillaLauncherEditorField1:SetFocus()
            end
        end

        function BenillaLauncherEditor_Close()
            BenillaLauncherEditorField1:ClearFocus()
            BenillaLauncherEditorField2:ClearFocus()
            BenillaLauncherEditorField3:ClearFocus()
            BenillaLauncherEditorField2:SetText("")
            BenillaLauncherEditor:Hide()
            BenillaLauncherFrame:Show()
        end

        function BenillaLauncherEditor_Save(signIn)
            local e = BenillaLauncherEditor
            local a, b, c = BenillaLauncherEditorField1:GetText(), BenillaLauncherEditorField2:GetText(),
                BenillaLauncherEditorField3:GetText()
            if e.kind == "server" then
                local index, err = BenillaLauncher_SaveProfile(e.server, a, b, c)
                if not index then
                    BenillaLauncherEditorError:SetText(err or "")
                    return
                end
                BenillaLauncher.server = index
            else
                if a == "" then
                    BenillaLauncherEditorError:SetText("Enter the account name.")
                    return
                end
                local j = BenillaLauncher_SaveAccount(e.server, a, b)
                if not j then return end
                e.account = j
            end
            local kind, i, j = e.kind, e.server, e.account
            BenillaLauncherEditor_Close()
            BenillaLauncher_Refresh()
            if signIn and kind == "account" then
                BenillaLauncher_SignIn(i, j)
            end
        end
    ]]></Script>

    <Button name="BenillaLauncherServerTemplate" virtual="true">
