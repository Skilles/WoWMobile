                    <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="40" y="-56"/></Offset></Anchor></Anchors>
                </FontString>
                <FontString name="BenillaLauncherEditorLabel2" inherits="GlueFontNormal" justifyH="LEFT">
