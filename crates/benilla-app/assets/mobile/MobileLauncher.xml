        <Layers>
            <Layer level="ARTWORK">
                <FontString name="$parentName" inherits="GlueFontNormalLarge" justifyH="LEFT">
                    <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="14" y="-8"/></Offset></Anchor></Anchors>
                </FontString>
                <FontString name="$parentAddress" inherits="GlueFontDisableSmall" justifyH="LEFT">
                    <Anchors><Anchor point="BOTTOMLEFT"><Offset><AbsDimension x="14" y="10"/></Offset></Anchor></Anchors>
                </FontString>
            </Layer>
        </Layers>
        <HighlightTexture file="Interface\Buttons\UI-Listbox-Highlight" alphaMode="ADD"/>
        <Scripts>
            <OnClick>
                PlaySound("igMainMenuOptionCheckBoxOn")
                BenillaLauncher.server = this.index
                BenillaLauncher.accountTop = 0
                BenillaLauncher_Refresh()
            </OnClick>
        </Scripts>
    </Button>

    <Button name="BenillaLauncherAccountTemplate" virtual="true">
        <Size><AbsDimension x="380" y="58"/></Size>
        <Layers>
            <Layer level="ARTWORK">
                <FontString name="$parentName" inherits="GlueFontHighlightLarge" justifyH="LEFT">
                    <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="14" y="-8"/></Offset></Anchor></Anchors>
                </FontString>
                <FontString name="$parentState" inherits="GlueFontNormalSmall" justifyH="LEFT">
                    <Anchors><Anchor point="BOTTOMLEFT"><Offset><AbsDimension x="14" y="10"/></Offset></Anchor></Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Button name="$parentRemove" inherits="GlueButtonSmallTemplate" text="Remove">
                <Size><AbsDimension x="96" y="40"/></Size>
                <Anchors><Anchor point="RIGHT"><Offset><AbsDimension x="-8" y="0"/></Offset></Anchor></Anchors>
                <Scripts><OnClick>
                    BenillaLauncher_DeleteAccount(BenillaLauncher.server, this:GetParent().index)
                    BenillaLauncher_Refresh()
                </OnClick></Scripts>
            </Button>
        </Frames>
        <HighlightTexture file="Interface\Buttons\UI-Listbox-Highlight" alphaMode="ADD"/>
        <Scripts>
            <OnClick>
                PlaySound("gsLogin")
                BenillaLauncher_SignIn(BenillaLauncher.server, this.index)
            </OnClick>
        </Scripts>
    </Button>

    <EditBox name="BenillaLauncherEditBoxTemplate" letters="64" autoFocus="false" virtual="true">
        <Size><AbsDimension x="520" y="46"/></Size>
        <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background" edgeFile="Interface\Glues\Common\Glue-Tooltip-Border" tile="true">
            <BackgroundInsets><AbsInset left="10" right="5" top="4" bottom="9"/></BackgroundInsets>
            <TileSize><AbsValue val="16"/></TileSize>
            <EdgeSize><AbsValue val="16"/></EdgeSize>
        </Backdrop>
        <Scripts>
            <OnEscapePressed>BenillaLauncherEditor_Close()</OnEscapePressed>
            <OnEnterPressed>BenillaLauncherEditor_Save(BenillaLauncherEditor.kind == "account")</OnEnterPressed>
        </Scripts>
        <FontString inherits="GlueEditBoxFont"/>
        <TextInsets><AbsInset left="15" bottom="5"/></TextInsets>
    </EditBox>

