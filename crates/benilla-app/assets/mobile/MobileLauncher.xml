                </FontString>
                <FontString name="BenillaLauncherEditorLabel3" inherits="GlueFontNormal" justifyH="LEFT">
                    <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="40" y="-228"/></Offset></Anchor></Anchors>
                </FontString>
                <FontString name="BenillaLauncherEditorError" inherits="GlueFontRed">
                    <Anchors><Anchor point="BOTTOM"><Offset><AbsDimension x="0" y="76"/></Offset></Anchor></Anchors>
                </FontString>
