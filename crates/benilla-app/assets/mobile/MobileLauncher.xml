            <Button name="BenillaLauncherServer5" inherits="BenillaLauncherServerTemplate">
                <Anchors><Anchor point="TOPLEFT" relativeTo="BenillaLauncherServer4" relativePoint="BOTTOMLEFT"/></Anchors>
            </Button>
