            </Button>
            <Button name="BenillaLauncherEditServer" inherits="GlueButtonSmallTemplate" text="Edit">
                <Size><AbsDimension x="124" y="48"/></Size>
                <Anchors><Anchor point="LEFT" relativeTo="BenillaLauncherAddServer" relativePoint="RIGHT"><Offset><AbsDimension x="4" y="0"/></Offset></Anchor></Anchors>
                <Scripts><OnClick>BenillaLauncherEditor_Open("server", BenillaLauncher.server, nil)</OnClick></Scripts>
            </Button>
            <Button name="BenillaLauncherRemoveServer" inherits="GlueButtonSmallTemplate" text="Remove">
                <Size><AbsDimension x="124" y="48"/></Size>
                <Anchors><Anchor point="LEFT" relativeTo="BenillaLauncherEditServer" relativePoint="RIGHT"><Offset><AbsDimension x="4" y="0"/></Offset></Anchor></Anchors>
                <Scripts><OnClick>
                    BenillaLauncher_DeleteProfile(BenillaLauncher.server)
                    BenillaLauncher_Refresh()
                </OnClick></Scripts>
            </Button>
            <Button name="BenillaLauncherAddAccount" inherits="GlueButtonSmallTemplate" text="Add Account">
                <Size><AbsDimension x="160" y="48"/></Size>
                <Anchors><Anchor point="BOTTOMLEFT"><Offset><AbsDimension x="422" y="68"/></Offset></Anchor></Anchors>
                <Scripts><OnClick>BenillaLauncherEditor_Open("account", BenillaLauncher.server, nil)</OnClick></Scripts>
            </Button>
            <Button name="BenillaLauncherManual" inherits="GlueButtonSmallTemplate" text="Sign In Manually">
                <Size><AbsDimension x="200" y="48"/></Size>
                <Anchors><Anchor point="BOTTOMRIGHT"><Offset><AbsDimension x="-22" y="14"/></Offset></Anchor></Anchors>
                <Scripts><OnClick>BenillaLauncher_ShowStock(1)</OnClick></Scripts>
            </Button>
            <CheckButton name="BenillaLauncherAuto">
                <Size><AbsDimension x="40" y="40"/></Size>
                <Anchors><Anchor point="BOTTOMLEFT"><Offset><AbsDimension x="22" y="14"/></Offset></Anchor></Anchors>
                <Layers>
                    <Layer level="ARTWORK">
                        <FontString inherits="GlueFontNormal" text="Sign in automatically">
                            <Anchors><Anchor point="LEFT" relativePoint="RIGHT"><Offset><AbsDimension x="4" y="0"/></Offset></Anchor></Anchors>
                        </FontString>
                    </Layer>
                </Layers>
                <NormalTexture file="Interface\Buttons\UI-CheckBox-Up"/>
                <PushedTexture file="Interface\Buttons\UI-CheckBox-Down"/>
                <HighlightTexture file="Interface\Buttons\UI-CheckBox-Highlight" alphaMode="ADD"/>
                <CheckedTexture file="Interface\Buttons\UI-CheckBox-Check"/>
                <Scripts><OnClick>
                    if this:GetChecked() then
                        BenillaLauncher_SetAutoLogin(1)
                        ConsoleExec("mobileAutoLogin 1")
                    else
                        BenillaLauncher_SetAutoLogin(nil)
                        ConsoleExec("mobileAutoLogin 0")
                    end
                </OnClick></Scripts>
            </CheckButton>
        </Frames>
        <Scripts>
            <!-- A finger's size: the glue is drawn 768 units high, about 440 points on a phone. -->
            <OnLoad>this:SetScale(1.25)</OnLoad>
            <OnShow>BenillaLauncherFrame_OnShow()</OnShow>
            <OnUpdate>BenillaLauncherFrame_OnUpdate()</OnUpdate>
        </Scripts>
    </Frame>

    <!-- Back to the launcher from the stock boxes. -->
    <Button name="BenillaLauncherBack" inherits="GlueButtonSmallTemplate" parent="AccountLoginUI" text="Saved Accounts" hidden="true">
        <Size><AbsDimension x="200" y="48"/></Size>
        <Anchors><Anchor point="TOP" relativeTo="AccountLoginLoginButton" relativePoint="BOTTOM"><Offset><AbsDimension x="0" y="-12"/></Offset></Anchor></Anchors>
        <Scripts><OnClick>BenillaLauncher_ShowStock(nil)</OnClick></Scripts>
    </Button>

    <Frame name="BenillaLauncherEditor" parent="AccountLoginUI" frameStrata="DIALOG" enableMouse="true" hidden="true">
        <Size><AbsDimension x="600" y="440"/></Size>
        <!-- High, so the on-screen keyboard leaves it in view. -->
        <Anchors><Anchor point="TOP"><Offset><AbsDimension x="0" y="-40"/></Offset></Anchor></Anchors>
        <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background" edgeFile="Interface\Glues\Common\Glue-Tooltip-Border" tile="true">
            <BackgroundInsets><AbsInset left="10" right="5" top="4" bottom="9"/></BackgroundInsets>
            <TileSize><AbsValue val="16"/></TileSize>
            <EdgeSize><AbsValue val="16"/></EdgeSize>
        </Backdrop>
        <Layers>
            <Layer level="ARTWORK">
                <FontString name="BenillaLauncherEditorTitle" inherits="GlueFontNormalLarge">
                    <Anchors><Anchor point="TOP"><Offset><AbsDimension x="0" y="-18"/></Offset></Anchor></Anchors>
                </FontString>
